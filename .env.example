# Port host untuk docker compose. Ganti kalau bentrok dengan project lain,
# lalu samakan port di DATABASE_URL, TEST_DATABASE_URL, S3_ENDPOINT, dan SMTP_PORT.
POSTGRES_PORT=5432
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

DATABASE_URL=postgres://app:app@localhost:5432/app
TEST_DATABASE_URL=postgres://app:app@localhost:5432/app_test
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=devaccesskey
S3_SECRET_ACCESS_KEY=devsecretkey
SMTP_HOST=localhost
SMTP_PORT=1025
# Hanya dipakai server hasil build (`bun run start` / Docker); `vite dev` mengabaikannya.
ORIGIN=http://localhost:3000
